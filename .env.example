# PostgreSQL used by Docker Compose services.
POSTGRES_DB=knowledge_poc
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=knowledge
DATABASE_URL=postgresql://knowledge:knowledge@postgres:5432/knowledge_poc

# Keep these blank until the local pipeline has passed and live sync is intended.
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_ID=

# Interactive Atlassian OAuth 2.0 (3LO), using organisation-managed Entra SSO.
# The probe requests read-only page and space scopes, keeps the access token in
# memory only, and never opens PostgreSQL.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_REDIRECT_URI=http://localhost:8765/callback
CONFLUENCE_SPACE_KEY=S3CR

# Local, no-cost embeddings. The first run downloads the model into model_cache.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
POLL_INTERVAL_SECONDS=300
